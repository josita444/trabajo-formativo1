
---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Descubre los talleres creativos de ArteVivo y encuentra nuevas formas de expresar tu imaginación."
    />
    <title>ArteVivo | Talleres creativos</title>
  </head>

  <body>
    <Header />

    <main>
      <!-- PORTADA PRINCIPAL -->
      <section class="hero-talleres">
        <div class="hero-luz luz-rosa"></div>
        <div class="hero-luz luz-violeta"></div>

        <div class="hero-contenido">
          <span class="etiqueta">✦ DESCUBRE TU CREATIVIDAD</span>

          <h1>
            Tu imaginación
            <span>no tiene límites.</span>
          </h1>

          <p>
            Explora nuevas ideas, experimenta con colores y descubre todo lo
            que eres capaz de crear. En ArteVivo, cada experiencia es una
            oportunidad para expresarte.
          </p>

          <div class="hero-botones">
            <a href="#nuestros-talleres" class="boton boton-amarillo">
              Explorar talleres <span>↗</span>
            </a>

            <a href="/contacto" class="boton boton-transparente">
              Contáctanos
            </a>
          </div>

          <div class="hero-frase">
            <span class="estrella">✦</span>
            CREA · EXPERIMENTA · INSPÍRATE
          </div>
        </div>

        <div class="hero-imagen">
          <div class="marco-imagen">
            <img
              src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=1000&q=85"
              alt="Materiales de pintura y arte en un espacio creativo"
            />
          </div>

          <div class="burbuja burbuja-superior">
            <span>✦</span> Inspira tu mente
          </div>

          <div class="burbuja burbuja-inferior">
            <strong>100%</strong>
            <span>Creatividad</span>
          </div>

          <span class="destello destello-uno">✦</span>
          <span class="destello destello-dos">✧</span>
        </div>
      </section>

      <!-- INTRODUCCIÓN -->
      <section class="introduccion">
        <div class="introduccion-texto">
          <span class="subtitulo">UN ESPACIO PARA TI</span>
          <h2>Hay muchas formas de <span>crear algo increíble.</span></h2>
        </div>

        <p>
          No necesitas ser un experto para comenzar. Solo necesitas curiosidad,
          ganas de aprender y la libertad de imaginar. Nuestros talleres están
          pensados para inspirarte y ayudarte a descubrir nuevas habilidades.
        </p>
      </section>

      <!-- TARJETAS DE TALLERES -->
      <section class="seccion-talleres" id="nuestros-talleres">
        <div class="encabezado-seccion">
          <div>
            <span class="subtitulo">ENCUENTRA TU INSPIRACIÓN</span>
            <h2>Explora nuestros <span>talleres.</span></h2>
          </div>

          <p>
            Elige lo que más te gusta y transforma tus ideas en experiencias.
          </p>
        </div>

        <div class="rejilla-talleres">
          <article class="tarjeta tarjeta-fotografia">
            <div class="tarjeta-imagen">
              <img
                src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=900&q=85"
                alt="Cámara fotográfica para aprender a capturar momentos"
                loading="lazy"
              />
              <span class="numero-taller">01</span>
            </div>

            <div class="tarjeta-contenido">
              <span class="categoria">CAPTURA MOMENTOS</span>
              <h3>Fotografía</h3>
              <p>
                Aprende a capturar momentos, jugar con la luz y contar
                historias a través de imágenes.
              </p>
              <a href="/fotografia" class="enlace-taller">
                Descubrir fotografía <span>↗</span>
              </a>
            </div>
          </article>

          <article class="tarjeta tarjeta-pintura">
            <div class="tarjeta-imagen">
              <img
                src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=900&q=85"
                alt="Pinturas y pinceles para experimentar con el arte"
                loading="lazy"
              />
              <span class="numero-taller">02</span>
            </div>

            <div class="tarjeta-contenido">
              <span class="categoria">DA VIDA A TUS IDEAS</span>
              <h3>Pintura e ilustración</h3>
              <p>
                Experimenta con colores, técnicas y formas para crear obras
                que reflejen tu personalidad.
              </p>
              <a href="/contacto" class="enlace-taller">
                Quiero participar <span>↗</span>
              </a>
            </div>
          </article>

          <article class="tarjeta tarjeta-creacion">
            <div class="tarjeta-imagen">
              <img
                src="https://images.unsplash.com/photo-1452860606245-08befc0ff44b?auto=format&fit=crop&w=900&q=85"
                alt="Materiales y proyectos de creación artística"
                loading="lazy"
              />
              <span class="numero-taller">03</span>
            </div>

            <div class="tarjeta-contenido">
              <span class="categoria">EXPLORA TU IMAGINACIÓN</span>
              <h3>Creación artística</h3>
              <p>
                Descubre materiales y técnicas diferentes para transformar
                ideas originales en creaciones únicas.
              </p>
              <a href="/contacto" class="enlace-taller">
                Quiero participar <span>↗</span>
              </a>
            </div>
          </article>

          <article class="tarjeta tarjeta-escritura">
            <div class="tarjeta-imagen">
              <img
                src="https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=900&q=85"
                alt="Cuaderno y lápiz para escribir historias"
                loading="lazy"
              />
              <span class="numero-taller">04</span>
            </div>

            <div class="tarjeta-contenido">
              <span class="categoria">CUENTA TU HISTORIA</span>
              <h3>Escritura creativa</h3>
              <p>
                Imagina personajes, inventa historias y encuentra tu propia
                voz a través de las palabras.
              </p>
              <a href="/contacto" class="enlace-taller">
                Quiero participar <span>↗</span>
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- BANNER FINAL -->
      <section class="banner-final">
        <div class="banner-luz"></div>

        <span class="subtitulo">TU PRÓXIMA IDEA COMIENZA AQUÍ</span>

        <h2>
          Atrévete a crear.
          <span>El mundo necesita tu arte.</span>
        </h2>

        <p>
          Da el primer paso, descubre tus talentos y comparte tu creatividad
          con ArteVivo.
        </p>

        <a href="/contacto" class="boton boton-amarillo">
          ¡Quiero participar! <span>↗</span>
        </a>

        <span class="banner-destello">✦</span>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #10091f;
    color: #fff8ff;
    font-family: Arial, Helvetica, sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(a) {
    text-decoration: none;
  }

  .hero-talleres {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 55px;
    min-height: 620px;
    padding: 95px max(7%, calc((100% - 1200px) / 2));
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 10% 20%, #6c1d9d55, transparent 45%),
      radial-gradient(ellipse at 90% 70%, #e82e9d30, transparent 40%),
      linear-gradient(135deg, #170b2d, #10091f 65%);
  }

  .hero-luz {
    position: absolute;
    z-index: -1;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.5;
    pointer-events: none;
  }

  .luz-rosa {
    top: -100px;
    right: 25%;
    background: #ed2fa7;
  }

  .luz-violeta {
    bottom: -150px;
    left: 10%;
    background: #762cff;
  }

  .hero-contenido {
    position: relative;
    z-index: 2;
    max-width: 590px;
  }

  .etiqueta,
  .subtitulo {
    display: inline-block;
    color: #ffdb58;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    line-height: 1.7;
  }

  .hero-contenido h1 {
    margin: 22px 0;
    font-size: clamp(43px, 5.2vw, 70px);
    font-weight: 900;
    letter-spacing: -3px;
    line-height: 1.06;
  }

  .hero-contenido h1 span,
  .introduccion h2 span,
  .encabezado-seccion h2 span {
    color: #ff66c4;
    text-shadow: 0 0 30px #f52da944;
  }

  .hero-contenido > p {
    max-width: 500px;
    color: #cfc4df;
    font-size: 16px;
    line-height: 1.9;
  }

  .hero-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 30px;
  }

  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    min-height: 50px;
    padding: 0 23px;
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 800;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  .boton:hover {
    transform: translateY(-4px);
  }

  .boton-amarillo {
    color: #21102e;
    background: #ffdc59;
    box-shadow: 0 0 25px #ffdc5933;
  }

  .boton-amarillo:hover {
    box-shadow: 0 0 35px #ffdc5980;
  }

  .boton-transparente {
    color: white;
    border-color: #ffffff48;
    background: #ffffff08;
  }

  .boton-transparente:hover {
    border-color: #ff66c4;
    background: #ff66c415;
  }

  .hero-frase {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 42px;
    color: #a99bbd;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .estrella {
    color: #ffdc59;
    font-size: 20px;
  }

  .hero-imagen {
    position: relative;
    width: 100%;
    max-width: 480px;
    justify-self: end;
    padding: 12px;
  }

  .marco-imagen {
    position: relative;
    height: 440px;
    overflow: hidden;
    border: 2px solid #ff66c477;
    border-radius: 48% 48% 24px 24px;
    background: #27113e;
    box-shadow:
      0 0 25px #ef36a333,
      0 0 70px #702cff33;
  }

  .marco-imagen::after {
    position: absolute;
    inset: 0;
    border: 1px solid #ffffff30;
    border-radius: inherit;
    content: "";
    pointer-events: none;
  }

  .marco-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .hero-imagen:hover .marco-imagen img {
    transform: scale(1.06);
  }

  .burbuja {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 14px 18px;
    border: 1px solid #ffffff22;
    border-radius: 14px;
    background: #211334eF;
    box-shadow: 0 12px 35px #00000040;
    backdrop-filter: blur(12px);
    font-size: 12px;
    font-weight: 700;
  }

  .burbuja-superior {
    top: 75px;
    left: -35px;
    color: #fff;
  }

  .burbuja-superior span {
    color: #ffdc59;
    font-size: 20px;
  }

  .burbuja-inferior {
    right: -20px;
    bottom: 45px;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  .burbuja-inferior strong {
    color: #ff66c4;
    font-size: 23px;
  }

  .burbuja-inferior span {
    color: #d3c4e2;
  }

  .destello {
    position: absolute;
    color: #ffdc59;
    text-shadow: 0 0 18px #ffdc59;
  }

  .destello-uno {
    top: 30px;
    right: 30px;
    font-size: 35px;
  }

  .destello-dos {
    bottom: 20px;
    left: 10px;
    color: #ff66c4;
    font-size: 30px;
  }

  .introduccion {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    align-items: center;
    gap: 70px;
    max-width: 1200px;
    margin: auto;
    padding: 100px 35px;
  }

  .introduccion h2,
  .encabezado-seccion h2 {
    margin: 15px 0 0;
    font-size: clamp(32px, 4vw, 46px);
    letter-spacing: -1.5px;
    line-height: 1.2;
  }

  .introduccion > p,
  .encabezado-seccion > p {
    color: #bdb0cf;
    font-size: 15px;
    line-height: 1.9;
  }

  .seccion-talleres {
    padding: 85px max(7%, calc((100% - 1200px) / 2)) 110px;
    background:
      radial-gradient(ellipse at 50% 0%, #7223a522, transparent 50%),
      #160d25;
  }

  .encabezado-seccion {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 45px;
  }

  .encabezado-seccion > p {
    max-width: 350px;
    margin-bottom: 5px;
  }

  .rejilla-talleres {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .tarjeta {
    overflow: hidden;
    border: 1px solid #ffffff17;
    border-radius: 22px;
    background: linear-gradient(145deg, #261438, #1b1029);
    box-shadow: 0 12px 35px #00000020;
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .tarjeta:hover {
    transform: translateY(-8px);
    border-color: #ff66c477;
    box-shadow:
      0 18px 40px #00000035,
      0 0 25px #e92c9e17;
  }

  .tarjeta-imagen {
    position: relative;
    height: 260px;
    overflow: hidden;
    background: #2c1742;
  }

  .tarjeta-imagen::after {
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(transparent, #1d1029cc);
    content: "";
  }

  .tarjeta-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .tarjeta:hover .tarjeta-imagen img {
    transform: scale(1.07);
  }

  .numero-taller {
    position: absolute;
    z-index: 1;
    right: 18px;
    bottom: 15px;
    color: white;
    font-size: 35px;
    font-weight: 900;
    text-shadow: 0 0 20px #000;
  }

  .tarjeta-contenido {
    padding: 27px 28px 30px;
  }

  .categoria {
    color: #ffdc59;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .tarjeta-contenido h3 {
    margin: 12px 0;
    color: #fff;
    font-size: 26px;
  }

  .tarjeta-contenido p {
    min-height: 55px;
    color: #c5b8d4;
    font-size: 14px;
    line-height: 1.8;
  }

  .enlace-taller {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    color: #ff78cd;
    font-size: 13px;
    font-weight: 800;
    transition: color 0.25s ease;
  }

  .enlace-taller span {
    transition: transform 0.25s ease;
  }

  .enlace-taller:hover {
    color: #ffdc59;
  }

  .enlace-taller:hover span {
    transform: translate(4px, -4px);
  }

  .banner-final {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: 80px auto;
    padding: 75px 25px;
    max-width: 1100px;
    border: 1px solid #ff66c433;
    border-radius: 30px;
    background:
      radial-gradient(ellipse at 15% 20%, #f02fa433, transparent 45%),
      radial-gradient(ellipse at 90% 80%, #682cff66, transparent 45%),
      linear-gradient(130deg, #28113c, #190d2b);
    text-align: center;
  }

  .banner-luz {
    position: absolute;
    z-index: -1;
    top: -140px;
    left: 35%;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: #ed2fa7;
    filter: blur(120px);
    opacity: 0.22;
  }

  .banner-final h2 {
    margin: 20px 0;
    font-size: clamp(32px, 4.5vw, 52px);
    letter-spacing: -1.5px;
    line-height: 1.2;
  }

  .banner-final h2 span {
    display: block;
    margin-top: 8px;
    color: #ff66c4;
    text-shadow: 0 0 25px #ff66c433;
  }

  .banner-final p {
    max-width: 550px;
    margin: 0 auto 28px;
    color: #cfc1df;
    font-size: 15px;
    line-height: 1.8;
  }

  .banner-destello {
    position: absolute;
    top: 25px;
    right: 35px;
    color: #ffdc59;
    font-size: 40px;
    text-shadow: 0 0 20px #ffdc59;
  }

  @media (max-width: 850px) {
    .hero-talleres {
      grid-template-columns: 1fr;
      gap: 35px;
      padding: 75px 7%;
    }

    .hero-contenido {
      max-width: 680px;
    }

    .hero-imagen {
      justify-self: center;
      max-width: 430px;
    }

    .marco-imagen {
      height: 380px;
    }

    .introduccion {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 70px 7%;
    }

    .encabezado-seccion {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .seccion-talleres {
      padding: 70px 7%;
    }

    .banner-final {
      margin: 60px 5%;
    }
  }

  @media (max-width: 560px) {
    .hero-talleres {
      padding: 60px 6%;
    }

    .hero-contenido h1 {
      font-size: 45px;
      letter-spacing: -2px;
    }

    .hero-contenido > p {
      font-size: 14px;
    }

    .hero-botones {
      align-items: stretch;
      flex-direction: column;
    }

    .boton {
      width: 100%;
    }

    .marco-imagen {
      height: 320px;
      border-radius: 44% 44% 20px 20px;
    }

    .burbuja-superior {
      left: -5px;
    }

    .burbuja-inferior {
      right: -5px;
    }

    .introduccion {
      padding: 60px 6%;
    }

    .seccion-talleres {
      padding: 60px 6%;
    }

    .rejilla-talleres {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .tarjeta-imagen {
      height: 230px;
    }

    .tarjeta-contenido {
      padding: 24px;
    }

    .tarjeta-contenido p {
      min-height: auto;
    }

    .banner-final {
      margin: 45px 5%;
      padding: 60px 22px;
      border-radius: 22px;
    }

    .banner-final h2 {
      font-size: 34px;
    }

    .banner-destello {
      top: 12px;
      right: 15px;
      font-size: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .boton,
    .tarjeta,
    .tarjeta-imagen img,
    .marco-imagen img,
    .enlace-taller span {
      transition: none;
    }
  }
</style>

