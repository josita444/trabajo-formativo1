
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<link rel="stylesheet" href="static/css/global.css" />
<link rel="stylesheet" href="static/css/talleres.css" />

<Header />

<main>
  <section class="contenedor talleres">
    <div class="titulo-talleres">
      <span class="etiqueta">CREA · EXPLORA · IMAGINA</span>
      <h1>Encuentra tu lado creativo ✨</h1>
      <p>
        Participa en experiencias disenadas para aprender,
        experimentar y compartir tu creatividad.
      </p>
    </div>

    <div class="lista-talleres">
      <article class="taller">
        <img
          src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=800&q=80"
          alt="Pinturas y materiales artísticos"
        />
        <div>
          <h2>Pintura e ilustracion </h2>
          <p>Explora técnicas, colores y diferentes formas de dibujar.</p>
          <a href="/contacto">Mas información →</a>
        </div>
      </article>

      <article class="taller">
        <img
          src="https://images.unsplash.com/photo-1493106641515-6b5631de4bb9?auto=format&fit=crop&w=800&q=80"
          alt="Espacio creativo para realizar proyectos"
        />
        <div>
          <h2>Creacion artistica </h2>
          <p>Convierte tus ideas en proyectos originales y personales.</p>
          <a href="/contacto">Más información →</a>
        </div>
      </article>

      <article class="taller">
        <img
          src="https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=800&q=80"
          alt="Cuaderno para escritura creativa"
        />
        <div>
          <h2>Escritura creativa ✍️</h2>
          <p>Inventa historias, desarrolla personajes y expresa tus ideas.</p>
          <a href="/contacto">Más información →</a>
        </div>
      </article>
    </div>

    <section class="selector-creativo">
      <span class="etiqueta">TU PERSONALIDAD ARTÍSTICA</span>
      <h2>¿Qué despierta tu imaginación?</h2>
      <p>Elige una opción y descubre tu esencia creativa.</p>

      <div class="opciones-arte">
        <button class="opcion-arte" data-estilo="pintura">
          <span></span>
          <strong>Pintar</strong>
        </button>

        <button class="opcion-arte" data-estilo="foto">
          <span>📸</span>
          <strong>Fotografiar</strong>
        </button>

        <button class="opcion-arte" data-estilo="escritura">
          <span>✍️</span>
          <strong>Escribir</strong>
        </button>

        <button class="opcion-arte" data-estilo="manual">
          <span>🌺</span>
          <strong>Crear con las manos</strong>
        </button>
      </div>

      <div class="resultado-arte" id="resultado-arte" aria-live="polite">
        ✨ Tu resultado aparecerá aquí.
      </div>
    </section>
  </section>
</main>

<Footer />


