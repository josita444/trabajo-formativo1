
---
import Header from "/components/header.astro";
import Footer from "/components/footer.astro";
---

<link rel="stylesheet" href="static/css/global.css" />
<link rel="stylesheet" href="static/css/contacto.css" />

<Header />

<main>
  <section class="contenedor contacto">
    <div class="contacto-texto">
      <span class="etiqueta">HABLEMOS DE ARTE</span>
      <h1> ¡Conectemos!</h1>
      <p>
        ¿Quieres participar en nuestros talleres o conocer más
        sobre ArteVivo? Nos encantaría saber de ti.
      </p>

      <div class="datos">
        <p><strong>Correo:</strong> contacto@artevivo.cl</p>
        <p><strong>Horario:</strong> Lunes a viernes, 9:00 a 18:00</p>
        <p><strong>Ubicacion:</strong> Santiago, Chile</p>
      </div>

      <a class="boton" href="mailto:contacto@artevivo.cl">
        Enviar un correo
      </a>
    </div>

    <img
      src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=900&q=80"
      alt="Espacio lleno de materiales para crear arte"
    />
  </section>
</main>

<Footer />
