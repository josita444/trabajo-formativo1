

---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#211038" />
    <title>ArteVivo | Contacto</title>
  </head>

  <body>
    <Header />

    <main>
      <section class="contacto">
        <div class="luz luz-rosa"></div>
        <div class="luz luz-morada"></div>

        <div class="contacto-texto">
          <span class="etiqueta">
            <span class="punto"></span>
            ESTAMOS AQUÍ PARA TI
          </span>

          <h1>
            ¡Conectemos!
            <span>Hablemos de arte.</span>
          </h1>

          <p class="descripcion">
            ¿Quieres participar en nuestros talleres o conocer más sobre
            ArteVivo? Nos encantaría saber de ti. Comparte tus ideas,
            resuelve tus dudas y da el siguiente paso en tu camino creativo.
          </p>

          <a class="boton" href="mailto:contacto@artevivo.cl">
            Escríbenos un correo <span>↗</span>
          </a>

          <div class="datos">
            <div class="dato">
              <div class="icono">✉</div>
              <div>
                <span class="dato-titulo">CORREO ELECTRÓNICO</span>
                <a href="mailto:contacto@artevivo.cl">
                  contacto@artevivo.cl
                </a>
              </div>
            </div>

            <div class="dato">
              <div class="icono">◷</div>
              <div>
                <span class="dato-titulo">HORARIO DE ATENCIÓN</span>
                <p>Lunes a viernes, de 9:00 a 18:00</p>
              </div>
            </div>

            <div class="dato">
              <div class="icono">⌖</div>
              <div>
                <span class="dato-titulo">UBICACIÓN</span>
                <p>Santiago, Chile</p>
              </div>
            </div>
          </div>
        </div>

        <div class="contacto-visual">
          <div class="marco"></div>

          <div class="imagen-contacto">
            <img
              src="https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=1000&q=85"
              alt="Pinturas, pinceles y materiales artísticos"
            />
          </div>

          <div class="nota">
            <span class="nota-estrella">✳</span>
            <div>
              <strong>Las ideas crecen</strong>
              <p>cuando las compartimos.</p>
            </div>
          </div>

          <span class="destello destello-uno">✦</span>
          <span class="destello destello-dos">✧</span>
          <div class="circulo"></div>
        </div>

        <div class="pie-contacto">
          <span>ARTEVIVO · CREATIVIDAD SIN LÍMITES</span>
          <span>Nos encantará conocerte.</span>
        </div>
      </section>

      <section class="mensaje-final">
        <span class="subtitulo">TU PRÓXIMA IDEA COMIENZA AQUÍ</span>
        <h2>
          Todo gran proyecto
          <span>comienza con una conversación.</span>
        </h2>
        <a href="mailto:contacto@artevivo.cl" class="enlace-final">
          Hablemos de tu próxima idea <span>↗</span>
        </a>
      </section>
    </main>

    <Footer />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        background: #fff9fd;
        color: #2b203c;
        font-family: Arial, Helvetica, sans-serif;
      }

      :global(a) {
        text-decoration: none;
      }

      /* SECCIÓN PRINCIPAL */

      .contacto {
        position: relative;
        isolation: isolate;
        display: grid;
        grid-template-columns: 1fr 0.85fr;
        align-items: center;
        gap: 65px;
        padding: 80px 9% 110px;
        overflow: hidden;
        background:
          radial-gradient(ellipse at 10% 15%, #e33d9128, transparent 38%),
          radial-gradient(ellipse at 90% 80%, #7138df38, transparent 40%),
          linear-gradient(130deg, #211038, #321750 58%, #19132f);
        color: white;
      }

      .luz {
        position: absolute;
        z-index: -1;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
      }

      .luz-rosa {
        top: -150px;
        left: 35%;
        background: #e33d91;
        opacity: 0.45;
      }

      .luz-morada {
        right: -100px;
        bottom: -150px;
        background: #7138df;
        opacity: 0.6;
      }

      .contacto-texto {
        position: relative;
        z-index: 2;
        max-width: 570px;
      }

      .etiqueta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 11px 15px;
        border: 1px solid #ffffff38;
        border-radius: 30px;
        background: #ffffff0c;
        color: #f4ddff;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.6px;
      }

      .punto {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ffe34d;
        box-shadow: 0 0 12px #ffe34d;
      }

      .contacto h1 {
        margin: 27px 0 20px;
        color: white;
        font-size: clamp(43px, 5vw, 68px);
        line-height: 1.08;
        letter-spacing: -2.5px;
      }

      .contacto h1 span {
        display: block;
        margin-top: 8px;
        color: #ff79bf;
        font-size: 0.72em;
        letter-spacing: -1px;
      }

      .descripcion {
        max-width: 490px;
        color: #e4d8f0;
        font-size: 15px;
        line-height: 1.9;
      }

      .boton {
        display: inline-flex;
        align-items: center;
        gap: 25px;
        margin-top: 15px;
        padding: 16px 22px;
        border-radius: 10px;
        background: #ffe34d;
        color: #321750;
        font-size: 12px;
        font-weight: 900;
        box-shadow: 0 0 25px #ffe34d30;
        transition: transform 0.25s, background 0.25s;
      }

      .boton:hover {
        transform: translateY(-4px);
        background: white;
      }

      .boton span {
        font-size: 19px;
      }

      /* INFORMACIÓN DE CONTACTO */

      .datos {
        display: grid;
        gap: 0;
        margin-top: 35px;
        padding: 8px 22px;
        border: 1px solid #ffffff24;
        border-radius: 16px;
        background: #ffffff0b;
        backdrop-filter: blur(8px);
      }

      .dato {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 19px 0;
      }

      .dato + .dato {
        border-top: 1px solid #ffffff20;
      }

      .icono {
        display: grid;
        flex-shrink: 0;
        width: 43px;
        height: 43px;
        place-items: center;
        border: 1px solid #ff79bf45;
        border-radius: 12px;
        background: #e33d911a;
        color: #ff9ccc;
        font-size: 23px;
      }

      .dato-titulo {
        display: block;
        margin-bottom: 7px;
        color: #cbb6e1;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.3px;
      }

      .dato a,
      .dato p {
        margin: 0;
        color: white;
        font-size: 13px;
        line-height: 1.7;
        overflow-wrap: anywhere;
      }

      .dato a:hover {
        color: #ffe34d;
      }

      /* IMAGEN DESTACADA */

      .contacto-visual {
        position: relative;
        padding: 20px;
      }

      .marco {
        position: absolute;
        inset: 0;
        border: 1px solid #e879ff85;
        border-radius: 28px 100px 28px 100px;
        box-shadow:
          0 0 25px #e879ff20,
          inset 0 0 25px #e879ff10;
        transform: rotate(3deg);
      }

      .imagen-contacto {
        position: relative;
        overflow: hidden;
        border: 5px solid #ffffff30;
        border-radius: 28px 100px 28px 100px;
        box-shadow:
          0 0 30px #e33d9140,
          0 20px 60px #00000035;
      }

      .imagen-contacto img {
        display: block;
        width: 100%;
        height: 470px;
        object-fit: cover;
        transition: transform 0.5s;
      }

      .imagen-contacto:hover img {
        transform: scale(1.06);
      }

      .nota {
        position: absolute;
        right: -12px;
        bottom: 45px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        border: 1px solid #ffffff80;
        border-radius: 14px;
        background: #fffdf8;
        color: #2b203c;
        box-shadow: 0 12px 35px #00000030;
        transform: rotate(-3deg);
      }

      .nota-estrella {
        color: #e33d91;
        font-size: 34px;
      }

      .nota strong {
        font-size: 13px;
      }

      .nota p {
        margin: 5px 0 0;
        color: #71677c;
        font-size: 11px;
      }

      .destello {
        position: absolute;
        color: #ffe34d;
        text-shadow: 0 0 18px #ffe34d;
      }

      .destello-uno {
        top: 0;
        left: 0;
        font-size: 36px;
      }

      .destello-dos {
        right: -5px;
        bottom: 20%;
        color: #ff79bf;
        font-size: 45px;
        text-shadow: 0 0 18px #ff79bf;
      }

      .circulo {
        position: absolute;
        top: 12%;
        right: 0;
        width: 17px;
        height: 17px;
        border-radius: 50%;
        background: #ffe34d;
        box-shadow: 0 0 25px #ffe34d;
      }

      .pie-contacto {
        position: absolute;
        right: 9%;
        bottom: 25px;
        left: 9%;
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding-top: 17px;
        border-top: 1px solid #ffffff25;
        color: #cbb6e1;
        font-size: 9px;
        letter-spacing: 1.3px;
      }

      /* MENSAJE FINAL */

      .mensaje-final {
        padding: 75px 8%;
        background:
          radial-gradient(ellipse at 0% 100%, #e9d5ff70, transparent 45%),
          #fff9fd;
        text-align: center;
      }

      .subtitulo {
        color: #d73591;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 2px;
      }

      .mensaje-final h2 {
        max-width: 720px;
        margin: 20px auto;
        color: #2b203c;
        font-size: clamp(30px, 4vw, 44px);
        line-height: 1.25;
      }

      .mensaje-final h2 span {
        display: block;
        color: #7938d1;
      }

      .enlace-final {
        display: inline-flex;
        align-items: center;
        gap: 20px;
        margin-top: 12px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e33d91;
        color: #6d31cb;
        font-size: 13px;
        font-weight: 900;
      }

      .enlace-final span {
        font-size: 20px;
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .contacto {
          grid-template-columns: 1fr 0.85fr;
          gap: 30px;
          padding-right: 6%;
          padding-left: 6%;
        }

        .contacto h1 {
          font-size: 48px;
        }

        .imagen-contacto img {
          height: 390px;
        }

        .pie-contacto {
          right: 6%;
          left: 6%;
        }
      }

      @media (max-width: 700px) {
        .contacto {
          grid-template-columns: 1fr;
          gap: 45px;
          padding: 55px 7% 90px;
        }

        .contacto h1 {
          font-size: 48px;
        }

        .descripcion {
          font-size: 14px;
        }

        .contacto-visual {
          width: 100%;
          max-width: 480px;
          margin: 0 auto;
        }

        .imagen-contacto img {
          height: 350px;
        }

        .nota {
          right: -2px;
        }

        .pie-contacto {
          right: 7%;
          left: 7%;
          font-size: 8px;
        }

        .mensaje-final {
          padding: 60px 7%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
