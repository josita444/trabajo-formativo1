
---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#170b2d" />
    <meta
      name="description"
      content="Descubre ArteVivo, un espacio creativo para explorar la fotografía, el arte y nuevas experiencias."
    />
    <title>ArteVivo | El arte de mirar diferente</title>
  </head>

  <body>
    <Header />

    <main>
      <!-- PORTADA CON EL ESTILO DE INICIO -->
      <section class="portada">
        <div class="luz luz-rosa"></div>
        <div class="luz luz-violeta"></div>

        <div class="portada-contenido">
          <span class="etiqueta">✦ TU ESPACIO CREATIVO</span>

          <h1>
            El mundo se ve
            <span class="texto-color">diferente</span>
            a través de una lente.
          </h1>

          <p>
            Descubre la belleza de los pequeños detalles, experimenta con
            los colores y transforma tu forma de ver el mundo a través
            de la fotografía.
          </p>

          <div class="portada-botones">
            <a class="boton-principal" href="/talleres">
              Explorar talleres <span>↗</span>
            </a>

            <a class="boton-secundario" href="#galeria">
              Descubrir fotografía ↓
            </a>
          </div>

          <div class="portada-destacado">
            <span class="destacado-icono">✳</span>
            <div>
              <strong>Tu creatividad, sin límites.</strong>
              <p>Inspírate, experimenta y crea algo único.</p>
            </div>
          </div>
        </div>

        <div class="portada-imagen">
          <div class="marco-imagen">
            <img
              src="https://images.unsplash.com/photo-1452587925148-ce544e77e70d?auto=format&fit=crop&w=1200&q=85"
              alt="Cámara fotográfica preparada para capturar momentos"
            />
          </div>

          <div class="imagen-etiqueta">
            <span>✦</span>
            El arte de observar
          </div>

          <div class="burbuja-creativa">
            <strong>CREA</strong>
            <span>Tu mirada, tu historia</span>
          </div>

          <span class="destello destello-uno">✦</span>
          <span class="destello destello-dos">✧</span>
        </div>
      </section>

      <!-- INTRODUCCIÓN -->
      <section class="introduccion">
        <div>
          <span class="subtitulo">EXPLORA TU CREATIVIDAD</span>
          <h2>Una mirada, <span>mil historias.</span></h2>
        </div>

        <p>
          La fotografía nos permite capturar momentos, emociones e ideas
          que muchas veces pasan desapercibidos. Encuentra tu inspiración
          y descubre nuevas formas de contar historias con imágenes.
        </p>
      </section>

      <!-- GALERÍA DE FOTOGRAFÍA -->
      <section class="fotografia" id="galeria">
        <div class="encabezado-foto">
          <span class="subtitulo">DESCUBRE NUEVAS PERSPECTIVAS</span>
          <h2>El arte de <span>mirar diferente.</span></h2>
          <p>
            Cada imagen cuenta una historia. Explora diferentes formas
            de capturar el mundo, juega con la luz y encuentra tu propio
            estilo a través de la fotografía.
          </p>
        </div>

        <div class="galeria">
          <article class="foto-card tarjeta-morada">
            <div class="foto-contenedor">
              <img
                src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=900&q=85"
                alt="Montañas y paisaje natural"
                loading="lazy"
              />
              <span class="numero-card">01</span>
            </div>

            <div class="card-contenido">
              <span class="categoria">NATURALEZA</span>
              <h3>Fotografía de paisajes</h3>
              <p>
                Descubre la belleza de la naturaleza y captura sus colores,
                texturas y rincones inolvidables.
              </p>
              <a href="/talleres" class="enlace-card">
                Quiero explorar <span>↗</span>
              </a>
            </div>
          </article>

          <article class="foto-card tarjeta-rosa">
            <div class="foto-contenedor">
              <img
                src="https://images.unsplash.com/photo-1490730141103-6cac27aaab94?auto=format&fit=crop&w=900&q=85"
                alt="Luz cálida de un atardecer"
                loading="lazy"
              />
              <span class="numero-card">02</span>
            </div>

            <div class="card-contenido">
              <span class="categoria">INSPIRACIÓN</span>
              <h3>Luz, color y emoción</h3>
              <p>
                Aprende a jugar con la iluminación y los tonos para crear
                fotografías que transmitan emociones.
              </p>
              <a href="/talleres" class="enlace-card">
                Quiero explorar <span>↗</span>
              </a>
            </div>
          </article>

          <article class="foto-card tarjeta-amarilla">
            <div class="foto-contenedor">
              <img
                src="https://images.unsplash.com/photo-1452587925148-ce544e77e70d?auto=format&fit=crop&w=900&q=85"
                alt="Cámara fotográfica para crear imágenes"
                loading="lazy"
              />
              <span class="numero-card">03</span>
            </div>

            <div class="card-contenido">
              <span class="categoria">TÉCNICA</span>
              <h3>El arte de fotografiar</h3>
              <p>
                Experimenta con encuadres, perspectivas y composición
                para desarrollar tu propio estilo.
              </p>
              <a href="/talleres" class="enlace-card">
                Quiero explorar <span>↗</span>
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- BANNER FINAL -->
      <section class="banner-creativo">
        <div class="banner-luz"></div>

        <div class="banner-icono">✳</div>

        <div class="banner-texto">
          <span>EL SIGUIENTE PASO ES TUYO</span>
          <h2>Tu próxima gran idea comienza aquí.</h2>
          <p>
            Atrévete a aprender, experimentar y descubrir todo lo que
            puedes crear.
          </p>
        </div>

        <a href="/talleres" class="boton-banner">
          Encuentra tu taller <span>↗</span>
        </a>

        <span class="banner-destello">✦</span>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #10091f;
    color: #fff8ff;
    font-family: Arial, Helvetica, sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(a) {
    text-decoration: none;
  }

  /* PORTADA */
  .portada {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 55px;
    min-height: 620px;
    padding: 90px max(7%, calc((100% - 1200px) / 2));
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 10% 20%, #6c1d9d55, transparent 45%),
      radial-gradient(ellipse at 90% 70%, #e82e9d30, transparent 40%),
      linear-gradient(135deg, #170b2d, #10091f 65%);
  }

  .luz {
    position: absolute;
    z-index: -1;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.5;
    pointer-events: none;
  }

  .luz-rosa {
    top: -100px;
    right: 25%;
    background: #ed2fa7;
  }

  .luz-violeta {
    bottom: -150px;
    left: 10%;
    background: #762cff;
  }

  .portada-contenido {
    position: relative;
    z-index: 2;
    max-width: 590px;
  }

  .etiqueta,
  .subtitulo {
    display: inline-block;
    color: #ffdc59;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    line-height: 1.7;
  }

  .etiqueta {
    padding: 9px 14px;
    border: 1px solid #ff66c455;
    border-radius: 30px;
    background: #ff66c410;
  }

  .portada h1 {
    max-width: 650px;
    margin: 25px 0 20px;
    font-size: clamp(42px, 5.2vw, 70px);
    line-height: 1.06;
    letter-spacing: -2.8px;
    font-weight: 900;
  }

  .texto-color {
    display: block;
    color: #ff66c4;
    text-shadow: 0 0 30px #f52da944;
  }

  .portada-contenido > p {
    max-width: 520px;
    color: #cfc4df;
    font-size: 16px;
    line-height: 1.9;
  }

  .portada-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 15px;
    margin-top: 30px;
  }

  .boton-principal,
  .boton-secundario,
  .boton-banner {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    min-height: 50px;
    padding: 15px 23px;
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 800;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  .boton-principal {
    color: #21102e;
    background: #ffdc59;
    box-shadow: 0 0 25px #ffdc5933;
  }

  .boton-principal:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 35px #ffdc5980;
  }

  .boton-secundario {
    color: white;
    border-color: #ffffff48;
    background: #ffffff08;
  }

  .boton-secundario:hover {
    transform: translateY(-4px);
    border-color: #ff66c4;
    background: #ff66c415;
  }

  .portada-destacado {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 38px;
  }

  .destacado-icono {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 45px;
    height: 45px;
    color: #ffdc59;
    border: 1px solid #ffdc5940;
    border-radius: 14px;
    background: #ffdc5912;
    font-size: 24px;
  }

  .portada-destacado strong {
    color: #fff;
    font-size: 14px;
  }

  .portada-destacado p {
    margin: 5px 0 0;
    color: #bdb0cf;
    font-size: 13px;
  }

  /* IMAGEN PRINCIPAL */
  .portada-imagen {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 480px;
    justify-self: end;
    padding: 12px;
  }

  .marco-imagen {
    height: 440px;
    overflow: hidden;
    border: 2px solid #ff66c477;
    border-radius: 48% 48% 24px 24px;
    background: #27113e;
    box-shadow:
      0 0 25px #ef36a333,
      0 0 70px #702cff33;
  }

  .marco-imagen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .portada-imagen:hover .marco-imagen img {
    transform: scale(1.06);
  }

  .imagen-etiqueta {
    position: absolute;
    z-index: 2;
    right: -15px;
    bottom: 80px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px 20px;
    color: #fff;
    border: 1px solid #ffffff22;
    border-radius: 14px;
    background: #211334ef;
    box-shadow: 0 12px 35px #00000040;
    backdrop-filter: blur(12px);
    font-size: 13px;
    font-weight: 800;
  }

  .imagen-etiqueta span {
    color: #ffdc59;
    font-size: 23px;
  }

  .burbuja-creativa {
    position: absolute;
    right: -12px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 16px 20px;
    border: 1px solid #ffffff22;
    border-radius: 14px;
    background: #211334ef;
    box-shadow: 0 12px 35px #00000040;
    backdrop-filter: blur(12px);
  }

  .burbuja-creativa strong {
    color: #ff66c4;
    font-size: 22px;
  }

  .burbuja-creativa span {
    color: #d3c4e2;
    font-size: 12px;
  }

  .destello {
    position: absolute;
    color: #ffdc59;
    text-shadow: 0 0 18px #ffdc59;
  }

  .destello-uno {
    top: 25px;
    right: 25px;
    font-size: 35px;
  }

  .destello-dos {
    bottom: 10px;
    left: 5px;
    color: #ff66c4;
    font-size: 30px;
  }

  /* INTRODUCCIÓN */
  .introduccion {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    align-items: center;
    gap: 70px;
    max-width: 1200px;
    margin: auto;
    padding: 95px 35px;
  }

  .introduccion h2 {
    margin: 15px 0 0;
    font-size: clamp(32px, 4vw, 46px);
    letter-spacing: -1.5px;
    line-height: 1.2;
  }

  .introduccion h2 span {
    color: #ff66c4;
    text-shadow: 0 0 25px #ff66c433;
  }

  .introduccion > p {
    color: #bdb0cf;
    font-size: 15px;
    line-height: 1.9;
  }

  /* GALERÍA */
  .fotografia {
    padding: 85px max(7%, calc((100% - 1200px) / 2)) 105px;
    background:
      radial-gradient(ellipse at 50% 0%, #7223a522, transparent 50%),
      #160d25;
  }

  .encabezado-foto {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .encabezado-foto h2 {
    margin: 17px 0;
    font-size: clamp(33px, 4vw, 49px);
    line-height: 1.15;
    letter-spacing: -1.5px;
  }

  .encabezado-foto h2 span {
    color: #ff66c4;
    text-shadow: 0 0 25px #ff66c433;
  }

  .encabezado-foto p {
    color: #bdb0cf;
    font-size: 15px;
    line-height: 1.9;
  }

  .galeria {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .foto-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #ffffff17;
    border-radius: 22px;
    background: linear-gradient(145deg, #261438, #1b1029);
    box-shadow: 0 12px 35px #00000020;
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .foto-card:hover {
    transform: translateY(-8px);
    border-color: #ff66c477;
    box-shadow:
      0 18px 40px #00000035,
      0 0 25px #e92c9e17;
  }

  .foto-contenedor {
    position: relative;
    overflow: hidden;
  }

  .foto-contenedor img {
    display: block;
    width: 100%;
    height: 245px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .foto-card:hover .foto-contenedor img {
    transform: scale(1.06);
  }

  .numero-card {
    position: absolute;
    top: 15px;
    left: 15px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid #ffffff45;
    border-radius: 12px;
    color: #21102e;
    background: #ffdc59;
    box-shadow: 0 0 20px #ffdc5933;
    font-size: 13px;
    font-weight: 900;
  }

  .card-contenido {
    padding: 25px 23px 27px;
  }

  .categoria {
    display: inline-block;
    padding: 7px 10px;
    border: 1px solid #ff66c433;
    border-radius: 6px;
    color: #ff83d0;
    background: #ff66c412;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1px;
  }

  .tarjeta-rosa .categoria {
    color: #ffdc59;
    border-color: #ffdc5933;
    background: #ffdc5910;
  }

  .tarjeta-amarilla .categoria {
    color: #c8a7ff;
    border-color: #a878ff44;
    background: #a878ff12;
  }

  .card-contenido h3 {
    margin: 17px 0 10px;
    color: #fff;
    font-size: 21px;
  }

  .card-contenido p {
    min-height: 78px;
    margin: 0;
    color: #c5b8d4;
    font-size: 14px;
    line-height: 1.8;
  }

  .enlace-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    color: #ff78cd;
    font-size: 13px;
    font-weight: 900;
    transition: color 0.25s ease;
  }

  .enlace-card span {
    transition: transform 0.25s ease;
  }

  .enlace-card:hover {
    color: #ffdc59;
  }

  .enlace-card:hover span {
    transform: translate(4px, -3px);
  }

  /* BANNER FINAL */
  .banner-creativo {
    position: relative;
    display: flex;
    align-items: center;
    gap: 25px;
    max-width: 1100px;
    margin: 80px auto;
    padding: 42px;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid #ff66c433;
    border-radius: 25px;
    color: white;
    background:
      radial-gradient(ellipse at 15% 20%, #f02fa433, transparent 45%),
      radial-gradient(ellipse at 90% 80%, #682cff66, transparent 45%),
      linear-gradient(130deg, #28113c, #190d2b);
  }

  .banner-luz {
    position: absolute;
    z-index: -1;
    top: -140px;
    left: 35%;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: #ed2fa7;
    filter: blur(120px);
    opacity: 0.22;
  }

  .banner-icono {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 75px;
    height: 75px;
    border: 1px solid #ffdc5944;
    border-radius: 20px;
    color: #ffdc59;
    background: #ffdc5910;
    font-size: 43px;
  }

  .banner-texto {
    flex: 1;
  }

  .banner-texto > span {
    color: #ffdc59;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .banner-texto h2 {
    margin: 10px 0;
    font-size: clamp(22px, 3vw, 33px);
  }

  .banner-texto p {
    margin: 0;
    color: #cfc1df;
    font-size: 14px;
    line-height: 1.7;
  }

  .boton-banner {
    flex-shrink: 0;
    color: #21102e;
    background: #ffdc59;
    box-shadow: 0 0 25px #ffdc5933;
  }

  .boton-banner:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 35px #ffdc5980;
  }

  .banner-destello {
    position: absolute;
    top: 15px;
    right: 20px;
    color: #ffdc59;
    font-size: 30px;
    text-shadow: 0 0 20px #ffdc59;
  }

  /* TABLET */
  @media (max-width: 950px) {
    .portada {
      gap: 30px;
      padding-right: 5%;
      padding-left: 5%;
    }

    .portada h1 {
      font-size: clamp(38px, 5vw, 54px);
    }

    .marco-imagen {
      height: 390px;
    }

    .introduccion {
      gap: 35px;
    }

    .fotografia {
      padding-right: 5%;
      padding-left: 5%;
    }

    .galeria {
      gap: 16px;
    }

    .card-contenido {
      padding: 20px 17px;
    }

    .card-contenido h3 {
      font-size: 18px;
    }

    .banner-creativo {
      margin-right: 5%;
      margin-left: 5%;
      padding: 35px;
    }
  }

  /* CELULARES */
  @media (max-width: 700px) {
    .portada {
      grid-template-columns: 1fr;
      gap: 35px;
      padding: 60px 6% 65px;
    }

    .portada h1 {
      font-size: clamp(41px, 10vw, 58px);
      letter-spacing: -1.8px;
    }

    .portada-contenido > p {
      font-size: 15px;
    }

    .portada-botones {
      align-items: stretch;
      flex-direction: column;
    }

    .boton-principal,
    .boton-secundario {
      width: 100%;
    }

    .portada-imagen {
      width: 90%;
      margin: 0 auto;
      justify-self: center;
    }

    .marco-imagen {
      height: 370px;
      border-radius: 44% 44% 20px 20px;
    }

    .imagen-etiqueta {
      right: -8px;
      bottom: 70px;
    }

    .burbuja-creativa {
      right: -5px;
      bottom: 5px;
    }

    .introduccion {
      grid-template-columns: 1fr;
      gap: 15px;
      padding: 65px 7%;
    }

    .fotografia {
      padding: 70px 6%;
    }

    .galeria {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .foto-contenedor img {
      height: 270px;
    }

    .card-contenido {
      padding: 24px;
    }

    .card-contenido h3 {
      font-size: 22px;
    }

    .card-contenido p {
      min-height: auto;
    }

    .banner-creativo {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin: 50px 5%;
      padding: 35px 7%;
    }

    .banner-icono {
      width: 60px;
      height: 60px;
      font-size: 34px;
    }

    .boton-banner {
      width: 100%;
    }
  }

  @media (max-width: 450px) {
    .portada h1 {
      font-size: 40px;
    }

    .marco-imagen {
      height: 310px;
    }

    .introduccion h2,
    .encabezado-foto h2 {
      font-size: 32px;
    }

    .banner-texto h2 {
      font-size: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .foto-card,
    .foto-contenedor img,
    .marco-imagen img,
